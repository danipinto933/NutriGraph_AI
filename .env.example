# ==== NEO4J CONFIGURATION ====
NEO4J_AUTH=neo4j/your_password_here
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_PLUGINS=["apoc"]
NEO4J_dbms_security_procedures_unrestricted=apoc.*
NEO4J_URI=bolt://localhost:7687

# ==== REDIS CONFIGURATION ====
REDIS_URL=redis://localhost:6379

# ==== KAFKA CONFIGURATION ====
# Kafka running on KRaft mode (No Zookeeper)
KAFKA_CLUSTER_ID=your_kafka_cluster_id
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ==== SECURITY & AUTHENTICATION ====
JWT_SECRET=your_jwt_secret_key_change_in_production

# ==== LLM SETTINGS (OpenRouter) ====
OPENAI_API_KEY="sk-or-v1-your-openrouter-api-key-here"
OPENAI_API_BASE="https://openrouter.ai/api/v1"
LLM_MODEL="google/gemini-2.5-pro"

# ==== MICROSERVICES URLS ====
NUTRITION_GRAPH_SERVICE_URL="http://localhost:8001/api/v1"

# ==== FRONTEND API URLS ====
API_URL="http://localhost:8000/api/v1"
GRAPH_API_URL="http://localhost:8001/api/v1"
CHAT_API_URL="http://localhost:8002/api/v1"

# ==== EMAIL SMTP CONFIGURATION (GMAIL) ====
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASSWORD="your_google_app_password"
EMAIL_FROM="your_email@gmail.com"
FRONTEND_URL="http://localhost:4200"
